{
  "name": "yoyako-cloud-app",
  "version": "1.0.0",
  "private": true,
  "description": "تطبيق أندرويد لنظام Yoyako.cloud (يغلّف الموقع الحالي عبر Capacitor، مع إشعارات فورية وربط الحجوزات).",
  "scripts": {
    "build:bridge": "esbuild src/native-bridge.js --bundle --outfile=www/native-bridge.bundled.js --format=iife --target=es2019",
    "sync": "npm run build:bridge && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor-community/admob": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.0",
    "@capacitor/cli": "^6.0.0",
    "esbuild": "^0.21.0"
  }
}
